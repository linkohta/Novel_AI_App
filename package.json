{
  "name": "novelai-app",
  "version": "1.0.0",
  "description": "Novel AI 画像生成プロンプト送信・保存アプリ",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:web && electron .",
    "build:web": "esbuild src/capacitor-bridge.js --bundle --outfile=www/capacitor-bridge.bundle.js --format=iife --platform=browser",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win nsis portable"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "net.novelai.promptapp",
    "productName": "NovelAI 画像生成",
    "asar": true,
    "files": [
      "**/*",
      "!android/**",
      "!src/**",
      "!output/**",
      "!dist/**",
      "!capacitor.config.json",
      "!node_modules/@capacitor/android/**",
      "!*.log"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
