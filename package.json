{
  "name": "novelai-app",
  "version": "1.0.0",
  "description": "Novel AI 画像生成プロンプト送信・保存アプリ",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build:web && npm run build:electron && electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build:web && npm run build:electron && electron-builder",
    "dist:win": "npm run build:web && npm run build:electron && electron-builder --win nsis portable",
    "format": "prettier --write main.ts preload.ts electron shared src *.ts",
    "format:check": "prettier --check main.ts preload.ts electron shared src *.ts",
    "lint": "eslint main.ts preload.ts electron shared src *.ts"
  },
  "author": "",
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "net.novelai.promptapp",
    "productName": "NovelAI 画像生成",
    "asar": true,
    "files": [
      "**/*",
      "!src/**",
      "!electron/**",
      "!shared/**",
      "!output/**",
      "!dist/**",
      "!out-dev/**",
      "!*.ts",
      "!tsconfig*.json",
      "!*.log"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
