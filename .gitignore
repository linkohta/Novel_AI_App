node_modules/
output/*.png
output/*.json
output/batch_*/
!output/.gitkeep

# Vite build output — regenerate via `npm run build:web` (`vite build`)
www/

# electron-vite dev-mode build output (regenerate via `npm run dev`)
out-dev/

# tsc build output for main.ts/preload.ts/electron/shared (regenerate via `npm run build:electron`)
electron-dist/
*.tsbuildinfo

# Android build artifacts (regenerate via `npx cap sync`)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/*.iml
android/app/*.iml

# electron-builder output (regenerate via `npm run dist`)
dist/

# stray log files from manual test runs
*.log
