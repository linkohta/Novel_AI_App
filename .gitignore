# 依存パッケージ（`npm install` で再取得）
node_modules/

# 開発時に生成画像・リクエストJSONを書き出していた旧保存先。現在の保存先は
# ドキュメントフォルダ配下（CLAUDE.md参照）だが、誤コミット防止のため
# フォルダ構成用の .gitkeep 以外はすべて無視する（batch_*/queue_* 等のサブフォルダ含む）。
output/*
!output/.gitkeep

# Viteのビルド成果物（`npm run build:web` で再生成）
www/

# electron-vite dev の一時ビルド成果物（`npm run dev` で再生成）
out-dev/

# main.ts/preload.ts/electron/shared の tsc ビルド成果物（`npm run build:electron` で再生成）
electron-dist/
*.tsbuildinfo

# electron-builder の出力（`npm run dist` で再生成）
dist/

# 手動実行時のログファイル
*.log

# Claude Code がローカルで作る作業用ファイル（サブエージェント用のgit worktreeと
# 個人設定）。共有したい設定（.claude/settings.json 等）は追跡対象のまま残す。
.claude/worktrees/
.claude/settings.local.json

# OS・エディタが自動生成するファイル
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
